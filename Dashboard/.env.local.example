# URL de l'API REST du Back-end (NestJS) — voir ticket #14
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL du serveur WebSocket du Back-end (statuts live des scenarios/tâches)
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Copier ce fichier en .env.local et ajuster une fois le back-end dispo.
# .env.local n'est pas versionné (voir .gitignore généré par create-next-app).
