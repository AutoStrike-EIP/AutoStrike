# Réglages locaux lus par `docker compose` à la racine.
# Copier en .env (non versionné) et adapter à sa machine.

# Arguments Maven pour le build du Back-end. Sur un réseau où Maven Central est lent
# ou coupe les téléchargements (Chine continentale notamment), passer par le miroir :
# MAVEN_ARGS=-s .mvn/settings-cn.xml
MAVEN_ARGS=
